<ui:FluentWindow x:Class="DockerDualControl.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:DockerDualControl.App"
        xmlns:views="clr-namespace:DockerDualControl.App.Views"
        xmlns:vm="clr-namespace:DockerDualControl.App.ViewModels"
        mc:Ignorable="d"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Docker Dual Control"
        Icon="pack://application:,,,/Assets/logo.png"
        Width="1180" Height="720"
        MinWidth="860" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round">

    <ui:FluentWindow.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVis" />
        <local:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <local:InverseBoolConverter x:Key="InverseBool" />
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Docker Dual Control">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/logo.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- Engine status strip: every connected engine, always visible -->
        <Grid Grid.Row="1" Margin="16,4,16,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ItemsControl Grid.Column="0" ItemsSource="{Binding Engines}" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:EngineItemViewModel}">
                        <Border CornerRadius="14" Padding="10,5" Margin="0,0,8,0"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{Binding AccentBrush}" BorderThickness="1.5"
                                ToolTip="{Binding StatusText}">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="9" Height="9" CornerRadius="4.5"
                                        Background="{Binding AccentBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding DisplayName}" Margin="7,0,7,0"
                                           FontSize="12" VerticalAlignment="Center" />
                                <Border Width="7" Height="7" CornerRadius="3.5"
                                        Background="{Binding StatusBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding StatusText}" Margin="5,0,0,0"
                                           FontSize="11" Opacity="0.7" VerticalAlignment="Center" />
                                <ui:Button Margin="7,-3,-4,-3" Padding="6,1"
                                           FontSize="11"
                                           Appearance="Secondary"
                                           Content="Start"
                                           ToolTip="Start this engine"
                                           Visibility="{Binding CanStart, Converter={StaticResource BoolToVis}}"
                                           Command="{Binding DataContext.StartEngineCommand,
                                                     RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                           CommandParameter="{Binding}" />
                                <ui:Button Margin="7,-3,-4,-3" Padding="6,1"
                                           FontSize="11"
                                           Appearance="Secondary"
                                           Content="{Binding SwitchModeText}"
                                           ToolTip="Switch between Windows and Linux containers"
                                           Visibility="{Binding CanSwitchMode, Converter={StaticResource BoolToVis}}"
                                           Command="{Binding DataContext.SwitchEngineModeCommand,
                                                     RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                           CommandParameter="{Binding}" />
                                <ui:ProgressRing Width="14" Height="14" Margin="7,0,0,0"
                                                 IsIndeterminate="True"
                                                 Visibility="{Binding IsStarting, Converter={StaticResource BoolToVis}}" />
                                <ui:ProgressRing Width="14" Height="14" Margin="7,0,0,0"
                                                 IsIndeterminate="True"
                                                 Visibility="{Binding IsSwitching, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ProgressBar Grid.Column="1" IsIndeterminate="True" Height="4" Margin="16,0"
                         VerticalAlignment="Center"
                         Visibility="{Binding IsDiscovering, Converter={StaticResource BoolToVis}}" />
        </Grid>

        <Grid Grid.Row="2" Margin="8,4,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Navigation -->
            <ListBox Grid.Column="0" Margin="0,4,12,0" BorderThickness="0"
                     Background="Transparent"
                     ItemContainerStyle="{StaticResource NavItemStyle}"
                     SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal" Margin="4,6">
                        <ui:SymbolIcon Symbol="Box24" />
                        <TextBlock Text="Containers" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal" Margin="4,6">
                        <ui:SymbolIcon Symbol="Layer24" />
                        <TextBlock Text="Images" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
            </ListBox>

            <!-- Content -->
            <Grid Grid.Column="1">
                <TabControl SelectedIndex="{Binding SelectedTabIndex}"
                            BorderThickness="0" Background="Transparent" Padding="0"
                            Visibility="{Binding NoEnginesAvailable, Converter={StaticResource InverseBoolToVis}}">
                    <TabControl.ItemContainerStyle>
                        <Style TargetType="TabItem">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </Style>
                    </TabControl.ItemContainerStyle>
                    <TabItem>
                        <views:ContainersView DataContext="{Binding Containers}" />
                    </TabItem>
                    <TabItem>
                        <views:ImagesView DataContext="{Binding Images}" />
                    </TabItem>
                </TabControl>

                <!-- No engine reachable -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding NoEnginesAvailable, Converter={StaticResource BoolToVis}}">
                    <ui:SymbolIcon Symbol="PlugDisconnected24" FontSize="44" HorizontalAlignment="Center" Opacity="0.6" />
                    <TextBlock Text="No Docker engine is reachable" FontSize="18" FontWeight="SemiBold"
                               Margin="0,12,0,4" HorizontalAlignment="Center" />
                    <TextBlock Text="Make sure the Docker service is running on Windows or inside WSL, then try again."
                               Opacity="0.7" HorizontalAlignment="Center" />
                    <ui:Button Content="Try again" Appearance="Primary" Margin="0,16,0,0"
                               HorizontalAlignment="Center"
                               Command="{Binding DiscoverEnginesCommand}" />
                </StackPanel>

                <!-- Logo splash while engines are being discovered -->
                <Border Background="{DynamicResource ApplicationBackgroundBrush}"
                        Visibility="{Binding IsDiscovering, Converter={StaticResource BoolToVis}}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Image Source="pack://application:,,,/Assets/logo.png"
                               Width="220" Height="220"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <ui:ProgressRing IsIndeterminate="True" Width="30" Height="30"
                                         Margin="0,20,0,0" HorizontalAlignment="Center" />
                        <TextBlock Text="Connecting to Docker engines..."
                                   Margin="0,12,0,0" HorizontalAlignment="Center" Opacity="0.7" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
