<UserControl x:Class="DockerDualControl.App.Views.ImagesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:DockerDualControl.App"
             xmlns:vm="clr-namespace:DockerDualControl.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ImagesViewModel}">

    <UserControl.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVis" />
        <local:NullToCollapsedConverter x:Key="NullToCollapsed" />
        <local:InverseBoolConverter x:Key="InverseBool" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar / pull bar -->
        <Grid Grid.Row="0" Margin="0,4,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                <ui:TextBox Width="300"
                            Icon="{ui:SymbolIcon ArrowDownload24}"
                            PlaceholderText="Image to pull — for example nginx:latest"
                            Text="{Binding PullReference, UpdateSourceTrigger=PropertyChanged}"
                            IsEnabled="{Binding IsPulling, Converter={StaticResource InverseBool}}" />
                <TextBlock Text="to" VerticalAlignment="Center" Margin="10,0" Opacity="0.7" />
                <ComboBox MinWidth="150"
                          ItemsSource="{Binding AvailableEngines}"
                          SelectedItem="{Binding PullEngine}"
                          IsEnabled="{Binding IsPulling, Converter={StaticResource InverseBool}}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:EngineItemViewModel}">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="8" Height="8" CornerRadius="4"
                                        Background="{Binding AccentBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ShortName}" Margin="7,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <ui:Button Grid.Column="1" Margin="8,0,0,0" Appearance="Primary"
                       Content="Pull"
                       Command="{Binding PullCommand}"
                       IsEnabled="{Binding IsPulling, Converter={StaticResource InverseBool}}" />

            <ui:ProgressRing Grid.Column="2" Width="22" Height="22" Margin="10,0,0,0"
                             IsIndeterminate="True"
                             Visibility="{Binding IsPulling, Converter={StaticResource BoolToVis}}" />
        </Grid>

        <!-- Error bar -->
        <Border Grid.Row="1" Background="#33E81123" BorderBrush="#E81123" BorderThickness="1"
                CornerRadius="6" Padding="10,8" Margin="0,0,0,8"
                Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsed}}">
            <DockPanel>
                <ui:Button DockPanel.Dock="Right" Appearance="Transparent" Padding="4"
                           Icon="{ui:SymbolIcon Dismiss24}"
                           Command="{Binding DismissErrorCommand}" ToolTip="Dismiss" />
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Rows}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="None"
                  SelectionMode="Single" SelectionUnit="FullRow"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  Background="Transparent" BorderThickness="0"
                  RowBackground="Transparent"
                  CellStyle="{StaticResource DdcCellStyle}"
                  RowStyle="{StaticResource DdcRowStyle}"
                  RowHeight="48">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Engine" Width="140">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type vm:ImageRowViewModel}">
                            <Border CornerRadius="10" Padding="8,3" HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                    BorderBrush="{Binding EngineAccentBrush}" BorderThickness="1.2">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="7" Height="7" CornerRadius="3.5"
                                            Background="{Binding EngineAccentBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding EngineShortName}" Margin="6,0,0,0"
                                               FontSize="11" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Repository" Binding="{Binding Repository}" Width="1.6*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Tag" Binding="{Binding Tag}" Width="0.7*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
                            <Setter Property="FontSize" Value="12" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="0.6*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Created" Binding="{Binding CreatedSince}" Width="0.8*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTemplateColumn Header="Actions" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type vm:ImageRowViewModel}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                        IsEnabled="{Binding IsWorking, Converter={StaticResource InverseBool}}">
                                <ui:Button Appearance="Transparent" Padding="6" ToolTip="Run"
                                           Icon="{ui:SymbolIcon Play24}"
                                           Command="{Binding RunCommand}" />
                                <ui:Button Appearance="Transparent" Padding="6" ToolTip="Delete"
                                           Icon="{ui:SymbolIcon Delete24}"
                                           Command="{Binding DeleteCommand}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Empty state -->
        <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
            <ui:SymbolIcon Symbol="Layer24" FontSize="44" HorizontalAlignment="Center" Opacity="0.5" />
            <TextBlock Text="No images on this engine" FontSize="18" FontWeight="SemiBold"
                       Margin="0,12,0,4" HorizontalAlignment="Center" />
            <TextBlock Text="Pull an image to get started." Opacity="0.7" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
