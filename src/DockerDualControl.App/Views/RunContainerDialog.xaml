<ui:FluentWindow x:Class="DockerDualControl.App.Views.RunContainerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:DockerDualControl.App"
        xmlns:vm="clr-namespace:DockerDualControl.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:RunContainerViewModel}"
        Title="Run a container"
        Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        ResizeMode="NoResize">

    <ui:FluentWindow.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVis" />
        <local:NullToCollapsedConverter x:Key="NullToCollapsed" />
        <local:InverseBoolConverter x:Key="InverseBool" />
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.8" />
            <Setter Property="Margin" Value="0,10,0,4" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Run a container" ShowMinimize="False" ShowMaximize="False" />

        <StackPanel Grid.Row="1" Margin="20,4,20,20"
                    IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBool}}">
            <TextBlock Text="Engine" Style="{StaticResource FieldLabel}" />
            <ComboBox HorizontalAlignment="Left" MinWidth="220"
                      ItemsSource="{Binding Engines}"
                      SelectedItem="{Binding SelectedEngine}">
                <ComboBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:EngineItemViewModel}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="8" Height="8" CornerRadius="4"
                                    Background="{Binding AccentBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding DisplayName}" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock Text="Image (required)" Style="{StaticResource FieldLabel}" />
            <ui:TextBox Text="{Binding Image, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="nginx:latest" />

            <TextBlock Text="Container name" Style="{StaticResource FieldLabel}" />
            <ui:TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="Leave empty for a generated name" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Ports (host:container, one per line)" Style="{StaticResource FieldLabel}" />
                    <ui:TextBox Text="{Binding PortsText, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="8080:80"
                                AcceptsReturn="True" MinHeight="64" MaxHeight="120"
                                VerticalScrollBarVisibility="Auto"
                                FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Environment (KEY=value, one per line)" Style="{StaticResource FieldLabel}" />
                    <ui:TextBox Text="{Binding EnvText, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="MODE=production"
                                AcceptsReturn="True" MinHeight="64" MaxHeight="120"
                                VerticalScrollBarVisibility="Auto"
                                FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                </StackPanel>
            </Grid>

            <TextBlock Text="Volumes (host-path:container-path, one per line)" Style="{StaticResource FieldLabel}" />
            <ui:TextBox Text="{Binding VolumesText, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="C:\data:/data"
                        AcceptsReturn="True" MinHeight="48" MaxHeight="100"
                        VerticalScrollBarVisibility="Auto"
                        FontFamily="Cascadia Mono, Consolas" FontSize="12" />

            <TextBlock Text="Command override" Style="{StaticResource FieldLabel}" />
            <ui:TextBox Text="{Binding Command, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="Leave empty to use the image default"
                        FontFamily="Cascadia Mono, Consolas" FontSize="12" />

            <Border Background="#33E81123" BorderBrush="#E81123" BorderThickness="1"
                    CornerRadius="6" Padding="10,8" Margin="0,12,0,0"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsed}}">
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <ui:ProgressRing Width="22" Height="22" Margin="0,0,10,0"
                                 IsIndeterminate="True" VerticalAlignment="Center"
                                 Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                <ui:Button Content="Cancel" Command="{Binding CancelCommand}" Margin="0,0,8,0" />
                <ui:Button Content="Run container" Appearance="Primary" Command="{Binding RunCommand}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
