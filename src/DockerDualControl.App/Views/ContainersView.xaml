<UserControl x:Class="DockerDualControl.App.Views.ContainersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:DockerDualControl.App"
             xmlns:vm="clr-namespace:DockerDualControl.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ContainersViewModel}">

    <UserControl.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVis" />
        <local:NullToCollapsedConverter x:Key="NullToCollapsed" />
        <local:InverseBoolConverter x:Key="InverseBool" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Grid Grid.Row="0" Margin="0,4,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ui:TextBox Grid.Column="0" MaxWidth="320" HorizontalAlignment="Left"
                        Icon="{ui:SymbolIcon Search24}"
                        PlaceholderText="Search by name or image"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

            <ui:Button Grid.Column="1" Appearance="Primary"
                       Icon="{ui:SymbolIcon Add24}"
                       Content="Run a container"
                       Command="{Binding RunContainerCommand}" />
        </Grid>

        <!-- Error bar -->
        <Border Grid.Row="1" Background="#33E81123" BorderBrush="#E81123" BorderThickness="1"
                CornerRadius="6" Padding="10,8" Margin="0,0,0,8"
                Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsed}}">
            <DockPanel>
                <ui:Button DockPanel.Dock="Right" Appearance="Transparent" Padding="4"
                           Icon="{ui:SymbolIcon Dismiss24}"
                           Command="{Binding DismissErrorCommand}" ToolTip="Dismiss" />
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- Grid -->
        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Rows}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="None"
                  SelectionMode="Single" SelectionUnit="FullRow"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  Background="Transparent" BorderThickness="0"
                  RowBackground="Transparent"
                  CellStyle="{StaticResource DdcCellStyle}"
                  RowHeight="52">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource DdcRowStyle}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsVisible}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="44">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type vm:ContainerRowViewModel}">
                            <Border Width="10" Height="10" CornerRadius="5"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    ToolTip="{Binding State}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource StoppedBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource RunningBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Engine" Width="140">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type vm:ContainerRowViewModel}">
                            <Border CornerRadius="10" Padding="8,3" HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                    BorderBrush="{Binding EngineAccentBrush}" BorderThickness="1.2">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="7" Height="7" CornerRadius="3.5"
                                            Background="{Binding EngineAccentBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding EngineShortName}" Margin="6,0,0,0"
                                               FontSize="11" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Name" Width="1.4*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type vm:ContainerRowViewModel}">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Names}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding ShortId}" FontFamily="Cascadia Mono, Consolas"
                                           FontSize="11" Opacity="0.6" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Image" Binding="{Binding Image}" Width="1.4*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="1.1*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTemplateColumn Header="Ports" Width="1.2*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type vm:ContainerRowViewModel}">
                            <TextBlock Text="{Binding Ports}" VerticalAlignment="Center"
                                       FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Ports}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Actions" Width="250">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type vm:ContainerRowViewModel}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                        IsEnabled="{Binding IsWorking, Converter={StaticResource InverseBool}}">
                                <ui:Button Appearance="Transparent" Padding="6" ToolTip="Start" AutomationProperties.Name="Start"
                                           Icon="{ui:SymbolIcon Play24}"
                                           Command="{Binding StartCommand}"
                                           Visibility="{Binding IsNotRunning, Converter={StaticResource BoolToVis}}" />
                                <ui:Button Appearance="Transparent" Padding="6" ToolTip="Stop" AutomationProperties.Name="Stop"
                                           Icon="{ui:SymbolIcon Stop24}"
                                           Command="{Binding StopCommand}"
                                           Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                                <ui:Button Appearance="Transparent" Padding="6" ToolTip="Restart" AutomationProperties.Name="Restart"
                                           Icon="{ui:SymbolIcon ArrowRepeatAll24}"
                                           Command="{Binding RestartCommand}"
                                           Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                                <ui:Button Appearance="Transparent" Padding="6" ToolTip="Logs" AutomationProperties.Name="Logs"
                                           Icon="{ui:SymbolIcon DocumentText24}"
                                           Command="{Binding OpenLogsCommand}" />
                                <ui:Button Appearance="Transparent" Padding="6" ToolTip="Terminal" AutomationProperties.Name="Terminal"
                                           Icon="{ui:SymbolIcon WindowConsole20}"
                                           Command="{Binding OpenShellCommand}"
                                           Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                                <ui:Button Appearance="Transparent" Padding="6" ToolTip="Delete" AutomationProperties.Name="Delete"
                                           Icon="{ui:SymbolIcon Delete24}"
                                           Command="{Binding RemoveCommand}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Empty state -->
        <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
            <ui:SymbolIcon Symbol="Box24" FontSize="44" HorizontalAlignment="Center" Opacity="0.5" />
            <TextBlock Text="No containers yet" FontSize="18" FontWeight="SemiBold"
                       Margin="0,12,0,4" HorizontalAlignment="Center" />
            <TextBlock Text="Run a container to get started." Opacity="0.7" HorizontalAlignment="Center" />
            <ui:Button Content="Run a container" Appearance="Primary" Margin="0,16,0,0"
                       HorizontalAlignment="Center" Command="{Binding RunContainerCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
